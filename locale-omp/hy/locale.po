#, fuzzy
msgid "plugins.blocks.visitorMap.description"
msgstr "Կողագոտու բլոկ՝ աշխարհի քարտեզով, որը ցույց է տալիս, թե որտեղից են գալիս հրատարակչության մուտքերը վերջին օրերին կամ որոշակի ամսաթվից ի վեր։ Օգտագործում է օգտագործման աշխարհագրական վիճակագրությունը, որը OMP-ն արդեն պահում է․ ոչինչ չի ուղարկվում այլ ծառայությունների։"

#, fuzzy
msgid "plugins.blocks.visitorMap.alt"
msgstr "Աշխարհի քարտեզ, որն ընդգծում է այն երկրները, որտեղից մուտք են գործում հրատարակչություն"

#, fuzzy
msgid "plugins.blocks.visitorMap.notice.geoDisabled"
msgstr "Քարտեզը դատարկ է, քանի որ օգտագործման աշխարհագրական վիճակագրությունն անջատված է։ Կայքի ադմինիստրատորը կարող է այն միացնել {$path} բաժնում (երկրի մակարդակը բավարար է)։ Այս հաղորդագրությունը տեսնում են միայն հրատարակչության կառավարիչները։"

#, fuzzy
msgid "plugins.blocks.visitorMap.notice.noData"
msgstr "Քարտեզը կհայտնվի, երբ օգտագործման վիճակագրությունը մշակվի աշխարհագրական տվյալներով, սովորաբար միացնելուց հաջորդ օրը։ Այս հաղորդագրությունը տեսնում են միայն հրատարակչության կառավարիչները։"

#, fuzzy
msgid "plugins.blocks.visitorMap.notice.emptyRange"
msgstr "Քարտեզի համար սահմանված ժամանակահատվածում հայտնի երկրից մուտքեր չկան։ Այս հաղորդագրությունը տեսնում են միայն հրատարակչության կառավարիչները։"

#, fuzzy
msgid "plugins.blocks.visitorMap.settings.intro"
msgstr "Քարտեզը ցույց է տալիս երկրները, որտեղից գալիս են մուտքերը՝ ըստ OMP-ի օգտագործման վիճակագրության։ Թարմացվում է ամեն ժամ՝ արդեն մշակված վիճակագրությունից, որը հասնում է մինչև երեկ։"

#, fuzzy
msgid "plugins.blocks.visitorMap.settings.startDate.description"
msgstr "Ըստ ցանկության։ Այս օրվանից առաջ մուտքերը երբեք չեն հաշվվում՝ անկախ օրերի քանակից, օրինակ՝ հրատարակչության վերագործարկումից հետո միայն հաշվելու համար։"

#, fuzzy
msgid "plugins.blocks.visitorMap.settings.metric.description"
msgstr "Եզակի մուտքերը նույն ընթերցողին հաշվում են մեկ անգամ յուրաքանչյուր գրքի և օրվա համար և ավելի քիչ են ազդվում ավտոմատացված երթևեկից։"

#, fuzzy
msgid "plugins.blocks.visitorMap.settings.antiScraper.description"
msgstr "Հեռացնում է դիտարկիչ ձևացող ռոբոտների մուտքերը (IP հասցեների երամներ, գոյություն չունեցող դիտարկիչներ, ավտոմատ հաճախորդներ)։ Չի փոխում OMP-ի պաշտոնական վիճակագրությունը։"
