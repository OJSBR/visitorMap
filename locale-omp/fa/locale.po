#, fuzzy
msgid "plugins.blocks.visitorMap.description"
msgstr "بلوک نوار کناری با نقشهٔ جهان از خاستگاه دسترسی‌ها به ناشر، در روزهای اخیر یا از یک تاریخ. از آمار جغرافیایی استفاده که OMP از پیش نگه می‌دارد استفاده می‌کند: هیچ چیز به سرویس‌های دیگر فرستاده نمی‌شود."

#, fuzzy
msgid "plugins.blocks.visitorMap.alt"
msgstr "نقشهٔ جهان که کشورهای منشأ دسترسی به ناشر را برجسته می‌کند"

#, fuzzy
msgid "plugins.blocks.visitorMap.notice.geoDisabled"
msgstr "نقشه خالی است زیرا آمار جغرافیایی استفاده غیرفعال است. مدیر سایت می‌تواند آن را در {$path} فعال کند (سطح کشور کافی است). فقط مدیران ناشر این پیام را می‌بینند."

#, fuzzy
msgid "plugins.blocks.visitorMap.notice.noData"
msgstr "نقشه پس از پردازش آمار استفاده با داده‌های جغرافیایی، معمولاً روز پس از فعال‌سازی، نمایش داده می‌شود. فقط مدیران ناشر این پیام را می‌بینند."

#, fuzzy
msgid "plugins.blocks.visitorMap.notice.emptyRange"
msgstr "در بازهٔ تعیین‌شده برای نقشه هیچ دسترسی با کشور شناخته‌شده وجود ندارد. فقط مدیران ناشر این پیام را می‌بینند."

#, fuzzy
msgid "plugins.blocks.visitorMap.settings.intro"
msgstr "نقشه کشورهایی را نشان می‌دهد که دسترسی‌ها از آن‌ها می‌آیند، بر اساس آمار استفادهٔ OMP. هر ساعت از آمار پردازش‌شده که تا دیروز است به‌روز می‌شود."

#, fuzzy
msgid "plugins.blocks.visitorMap.settings.startDate.description"
msgstr "اختیاری. دسترسی‌های پیش از این روز هرگز شمرده نمی‌شوند، هر تعداد روز که باشد؛ مثلاً برای شمارش فقط از زمان راه‌اندازی دوبارهٔ ناشر."

#, fuzzy
msgid "plugins.blocks.visitorMap.settings.metric.description"
msgstr "دسترسی‌های یکتا هر خواننده را برای هر کتاب و هر روز یک بار می‌شمارند و کمتر از ترافیک خودکار تأثیر می‌پذیرند."

#, fuzzy
msgid "plugins.blocks.visitorMap.settings.antiScraper.description"
msgstr "دسترسی‌های ربات‌هایی را که خود را مرورگر جا می‌زنند حذف می‌کند (دسته‌های نشانی IP، مرورگرهای ناموجود، کلاینت‌های خودکار). آمار رسمی OMP را تغییر نمی‌دهد."
