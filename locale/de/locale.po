msgid "plugins.blocks.visitorMap.displayName"
msgstr "Zugriffskarte"

msgid "plugins.blocks.visitorMap.description"
msgstr "Block für die Seitenleiste mit einer Weltkarte der Herkunft der Zugriffe auf die Zeitschrift, für die letzten Tage oder seit einem Datum. Er nutzt die geografischen Nutzungsstatistiken, die OJS bereits speichert: Es wird nichts an andere Dienste gesendet."

msgid "plugins.blocks.visitorMap.defaultTitle"
msgstr "Zugriffskarte"

msgid "plugins.blocks.visitorMap.alt"
msgstr "Weltkarte, die die Länder hervorhebt, aus denen auf die Zeitschrift zugegriffen wird"

msgid "plugins.blocks.visitorMap.countries"
msgstr "Länder"

msgid "plugins.blocks.visitorMap.topCountries"
msgstr "Länder mit den meisten Zugriffen"

msgid "plugins.blocks.visitorMap.metric.unique"
msgstr "Eindeutige Zugriffe"

msgid "plugins.blocks.visitorMap.metric.total"
msgstr "Zugriffe"

msgid "plugins.blocks.visitorMap.lastDays"
msgstr "Letzte {$days} Tage"

msgid "plugins.blocks.visitorMap.since"
msgstr "Seit {$date}"

msgid "plugins.blocks.visitorMap.notice.geoDisabled"
msgstr "Die Karte ist leer, weil die geografischen Nutzungsstatistiken ausgeschaltet sind. Eine Administratorin oder ein Administrator der Website kann sie unter {$path} einschalten (die Länderebene genügt). Nur die Zeitschriftenverwaltung sieht diese Meldung."

msgid "plugins.blocks.visitorMap.notice.noData"
msgstr "Die Karte erscheint, sobald die Nutzungsstatistiken mit geografischen Daten verarbeitet wurden, meist am Tag nach dem Einschalten. Nur die Zeitschriftenverwaltung sieht diese Meldung."

msgid "plugins.blocks.visitorMap.notice.emptyRange"
msgstr "Im für die Karte festgelegten Zeitraum gibt es keine Zugriffe mit bekanntem Land. Nur die Zeitschriftenverwaltung sieht diese Meldung."

msgid "plugins.blocks.visitorMap.task.name"
msgstr "Zugriffskarte: geografische Nutzungsstatistiken zusammenfassen"

msgid "plugins.blocks.visitorMap.settings.intro"
msgstr "Die Karte zeigt die Länder, aus denen die Zugriffe kommen, nach den Nutzungsstatistiken von OJS. Sie wird stündlich aktualisiert, aus den bereits verarbeiteten Statistiken, die bis gestern reichen."

msgid "plugins.blocks.visitorMap.settings.period"
msgstr "Zeitraum"

msgid "plugins.blocks.visitorMap.settings.days"
msgstr "Anzahl der Tage"

msgid "plugins.blocks.visitorMap.settings.days.description"
msgstr "Die Karte umfasst so viele Tage, bis gestern. Mit 0 wird alles seit dem Startdatum angezeigt."

msgid "plugins.blocks.visitorMap.settings.days.invalid"
msgstr "Geben Sie eine ganze Zahl von Tagen zwischen 0 und 3650 ein."

msgid "plugins.blocks.visitorMap.settings.startDate"
msgstr "Startdatum"

msgid "plugins.blocks.visitorMap.settings.startDate.description"
msgstr "Optional. Zugriffe vor diesem Tag werden nie gezählt, unabhängig von der Anzahl der Tage, etwa um erst ab einem Neustart der Zeitschrift zu zählen."

msgid "plugins.blocks.visitorMap.settings.startDate.invalid"
msgstr "Geben Sie ein gültiges Datum ein, das nicht in der Zukunft liegt."

msgid "plugins.blocks.visitorMap.settings.metric"
msgstr "Was gezählt wird"

msgid "plugins.blocks.visitorMap.settings.metric.description"
msgstr "Eindeutige Zugriffe zählen dieselbe Person einmal pro Artikel und Tag und werden weniger von automatisiertem Datenverkehr beeinflusst."

msgid "plugins.blocks.visitorMap.settings.metric.invalid"
msgstr "Wählen Sie, was gezählt wird."

msgid "plugins.blocks.visitorMap.settings.excludedCountries"
msgstr "Auszuschließende Länder"

msgid "plugins.blocks.visitorMap.settings.excludedCountries.description"
msgstr "Optional. Zweistellige Ländercodes (ISO 3166-1), durch Kommas getrennt, zum Beispiel „SG, IE“. Nützlich für Länder, deren Zugriffe überwiegend aus Rechenzentren stammen."

msgid "plugins.blocks.visitorMap.settings.excludedCountries.invalid"
msgstr "Verwenden Sie zweistellige Ländercodes (ISO 3166-1), durch Kommas getrennt."

msgid "plugins.blocks.visitorMap.settings.display"
msgstr "Darstellung"

msgid "plugins.blocks.visitorMap.settings.blockTitle"
msgstr "Titel des Blocks"

msgid "plugins.blocks.visitorMap.settings.showSummary"
msgstr "Anzahl der Zugriffe und der Länder anzeigen"

msgid "plugins.blocks.visitorMap.settings.topCount"
msgstr "Unter der Karte aufgeführte Länder"

msgid "plugins.blocks.visitorMap.settings.topCount.description"
msgstr "Von 0 (keine Liste) bis 20."

msgid "plugins.blocks.visitorMap.settings.topCount.invalid"
msgstr "Geben Sie eine ganze Zahl zwischen 0 und 20 ein."

msgid "plugins.blocks.visitorMap.settings.colorLand"
msgstr "Farbe der Länder ohne Zugriffe"

msgid "plugins.blocks.visitorMap.settings.colorHighlight"
msgstr "Farbe der Länder mit den meisten Zugriffen"

msgid "plugins.blocks.visitorMap.settings.color.invalid"
msgstr "Wählen Sie eine Farbe."

msgid "plugins.blocks.visitorMap.country.XK"
msgstr "Kosovo"
